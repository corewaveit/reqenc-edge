{
  "name": "reqenc-edge",
  "version": "1.0.0",
  "description": "Enterprise 15-layer end-to-end request encryption SDK for zero-trust microservices and edge proxies.",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "bin": {
    "reqenc": "./bin/cli.cjs"
  },
  "files": [
    "dist",
    "bin",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.cjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "reqenc",
    "security",
    "encryption",
    "rsa-oaep",
    "aes-gcm",
    "hmac",
    "zero-trust",
    "reverse-proxy",
    "edge-security",
    "cloudflare-workers",
    "microservices",
    "mitm-prevention"
  ],
  "author": "CoreWave IT (https://reqenc.cwit.site)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/corewaveit/reqenc-edge.git"
  },
  "bugs": {
    "url": "https://github.com/corewaveit/reqenc-edge/issues"
  },
  "homepage": "https://github.com/corewaveit/reqenc-edge#readme",
  "engines": {
    "node": ">=16.0.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "reqenc-edge": "^1.0.0"
  }
}
